# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# ==========================================================
# HTTP API
# ==========================================================
#
# Expo Web local:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Android físico / emulador:
#
# Usa una dirección alcanzable desde el dispositivo.
#
# Ejemplo LAN:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000


# ==========================================================
# REALTIME / SOCKET.IO
# ==========================================================
#
# Debe ser el origen HTTP(S) del servidor.
#
# NO agregar:
#
#   /ws
#   /socket.io
#
# El adapter realtime configura namespace y path.
#
# Desarrollo local:
# EXPO_PUBLIC_REALTIME_URL=http://192.168.1.100:3000
#
# Producción:
# EXPO_PUBLIC_REALTIME_URL=https://api.example.com
#
# Puede quedar vacío mientras realtime no se utilice.
EXPO_PUBLIC_REALTIME_URL=http://localhost:3000